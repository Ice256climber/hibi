  function newWeekMessage(judgeLabel, quote, tone){
    const templates = {
      polite: `先週は${judgeLabel}だったんですね。「${quote}」って言っていたこと、ちゃんと覚えていますよ`,
      semi:   `先週は${judgeLabel}だったね。「${quote}」って言ってたの、ちゃんと覚えてるよ`,
