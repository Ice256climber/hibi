<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>愛着を抱くには ― ヒビ</title>
<style>
  :root{
    --bg:#1B1F2B;
    --panel:#232838;
    --panel-alt:#2B3145;
    --text:#EDEAE3;
    --text-muted:#9AA0B4;
    --warm:#F2B85C;
    --good:#7FB77E;
    --soft-good:#A9C97E;
    --neutral:#9AA0B4;
    --soft-bad:#D89A7E;
    --bad:#C97064;
    --border: rgba(237,234,227,0.14);
    --serif: "Iowan Old Style","Palatino Linotype","Hiragino Mincho ProN","Book Antiqua", Georgia, serif;
    --sans: "Avenir Next","Hiragino Kaku Gothic ProN","Segoe UI","Helvetica Neue", Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--sans);
    line-height:1.7;
    padding:32px 20px 80px;
    min-height:100vh;
  }
  .page{ max-width:640px; margin:0 auto; }
  header.title{ text-align:center; margin-bottom:36px; }
  header.title h1{
    font-family:var(--serif);
    font-weight:400;
    font-size:28px;
    letter-spacing:0.02em;
    margin:0 0 6px;
  }
  header.title p{ color:var(--text-muted); font-size:13px; margin:0; }

  section{ margin-bottom:28px; }

  /* ---- character card ---- */
  .character-card{
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:28px 20px 24px;
    border-top:1px dashed var(--border);
    border-bottom:1px dashed var(--border);
  }
  .creature-wrap{
    width:170px;
    height:180px;
    margin-bottom:10px;
    position:relative;
    cursor:pointer;
    will-change:transform;
  }
  .creature-wrap:focus-visible{
    outline:2px solid var(--warm);
    outline-offset:8px;
    border-radius:50%;
  }
  .heart-particle{
    position:absolute;
    color:var(--warm);
    font-size:20px;
    pointer-events:none;
    text-shadow: 0 0 10px currentColor;
    animation: floatUp 2.1s ease-out forwards;
  }
  @keyframes floatUp{
    0%{ opacity:1; transform:translate(0,0) scale(0.7); }
    40%{ opacity:1; }
    100%{ opacity:0; transform:translate(var(--dx, 0px), -92px) scale(1.5); }
  }

  /* 頑張った週:急がず、じんわり灯りが立ちのぼるような柔らかい光 */
  .care-glow-orb{
    position:absolute;
    border-radius:50%;
    pointer-events:none;
    background: radial-gradient(circle, rgba(242,184,92,0.95) 0%, rgba(242,184,92,0.35) 45%, rgba(242,184,92,0) 75%);
    filter: blur(0.5px);
    animation: driftGlow 3.4s cubic-bezier(0.15,0.6,0.25,1) forwards;
  }
  @keyframes driftGlow{
    0%{ opacity:0; transform:translate(0,0) scale(0.3); }
    12%{ opacity:0.95; }
    60%{ opacity:0.75; }
    100%{ opacity:0; transform:translate(var(--dx, 0px), -130px) scale(2.1); }
  }

  /* お祝いの週:一気にはじけて広がる、華やかで速いバースト */
  .celebrate-particle{
    position:absolute;
    pointer-events:none;
    text-shadow: 0 0 6px currentColor;
    animation: burstOut 1.2s cubic-bezier(0.15,0.75,0.3,1) forwards;
  }
  @keyframes burstOut{
    0%{ opacity:1; transform:translate(0,0) scale(0.4) rotate(0deg); }
    70%{ opacity:1; }
    100%{ opacity:0; transform:translate(var(--dx, 0px), var(--dy, -70px)) scale(1.4) rotate(var(--rot, 120deg)); }
  }

  .char-name{ font-family:var(--serif); font-size:14px; color:var(--text-muted); margin:0 0 10px; }
  .familiarity{ width:220px; margin-bottom:16px; }
  .fam-label{ display:block; text-align:center; font-size:11px; color:var(--text-muted); margin-bottom:6px; }
  .fam-bar{ width:100%; height:4px; background:var(--panel-alt); border-radius:2px; overflow:hidden; }
  .fam-fill{ height:100%; background:var(--warm); width:0%; transition:width 0.3s; }

  .emblem-group{ margin-bottom:16px; }
  .emblem-group:last-child{ margin-bottom:0; }
  .emblem-label{ font-size:12px; color:var(--text-muted); margin-bottom:8px; }
  .emblem-icons{ display:flex; flex-wrap:wrap; align-items:center; gap:6px; font-size:17px; min-height:22px; }
  .emblem-icons .emblem-empty{ font-size:12px; color:var(--text-muted); }
  .emblem-icons .emblem-overflow{ font-size:12px; color:var(--text-muted); }
  .speech{ font-family:var(--serif); font-size:16px; text-align:center; max-width:460px; color:var(--text); }
  .speech .quote{ display:block; margin-top:10px; font-size:14px; color:var(--warm); }

  /* ---- panel ---- */
  .panel{ background:var(--panel); border:1px solid var(--border); border-radius:6px; padding:22px; }
  .panel + .panel{ margin-top:18px; }
  .panel h2{ font-family:var(--sans); font-weight:600; font-size:13px; color:var(--text-muted); margin:0 0 16px; }

  textarea{
    width:100%; min-height:80px;
    background:var(--panel-alt); border:1px solid var(--border); border-radius:4px;
    color:var(--text); font-family:var(--serif); font-size:15px; padding:12px 14px; resize:vertical;
  }
  textarea:focus{ outline:2px solid var(--warm); outline-offset:1px; }

  .mood-row{ display:flex; gap:8px; margin-top:14px; flex-wrap:wrap; }
  .mood-btn{
    flex:1 1 auto; min-width:64px; padding:10px 6px;
    background:var(--panel-alt); border:1px solid var(--border); border-radius:4px;
    color:var(--text-muted); font-family:var(--sans); font-size:13px; cursor:pointer;
    transition:border-color 0.15s, color 0.15s, background 0.15s;
  }
  .mood-btn:hover{ border-color:var(--warm); }
  .mood-btn:focus-visible{ outline:2px solid var(--warm); outline-offset:2px; }
  .mood-btn.selected{ color:var(--bg); font-weight:600; border-color:transparent; }

  .save-row{ display:flex; justify-content:space-between; align-items:center; margin-top:18px; flex-wrap:wrap; gap:10px; }
  .save-btn{
    background:var(--warm); color:#22160a; border:none; border-radius:4px;
    padding:11px 22px; font-family:var(--sans); font-weight:600; font-size:14px; cursor:pointer;
  }
  .save-btn:focus-visible{ outline:2px solid var(--text); outline-offset:2px; }
  .save-note{ font-size:12px; color:var(--text-muted); }

  /* ---- week summary ---- */
  .week-status{ display:inline-block; font-size:12px; padding:3px 10px; border-radius:20px; margin-left:8px; vertical-align:middle; }
  canvas#weekChart{ width:100%; height:120px; display:block; margin-top:14px; }
  .highlight-pair{ display:flex; gap:14px; margin-top:16px; flex-wrap:wrap; }
  .highlight-box{ flex:1 1 220px; background:var(--panel-alt); border-radius:4px; padding:14px 16px; border-left:3px solid var(--good); }
  .highlight-box.bad{ border-left-color:var(--bad); }
  .highlight-box .h-label{ font-size:11px; color:var(--text-muted); margin-bottom:6px; }
  .highlight-box .h-text{ font-family:var(--serif); font-size:14px; }

  /* ---- history ---- */
  details{ cursor:pointer; }
  summary{ font-size:13px; color:var(--text-muted); outline:none; }
  summary:focus-visible{ outline:2px solid var(--warm); }
  .history-list{ margin-top:14px; }
  .history-item{ display:flex; gap:12px; padding:10px 0; border-bottom:1px dashed var(--border); font-size:13px; }
  .history-item:last-child{ border-bottom:none; }
  .history-date{ color:var(--text-muted); width:78px; flex-shrink:0; }
  .history-dot{ width:9px;height:9px;border-radius:50%; flex-shrink:0; margin-top:5px; }
  .history-text{ font-family:var(--serif); }

  /* ---- adjustment controls (always visible) ---- */
  .adjust-row{ display:flex; align-items:center; gap:10px; margin-bottom:14px; flex-wrap:wrap; font-size:13px; }
  .adjust-row:last-child{ margin-bottom:0; }
  .adjust-row button{
    background:var(--panel-alt); border:1px solid var(--border); color:var(--text);
    padding:7px 14px; border-radius:4px; font-family:var(--sans); font-size:12px; cursor:pointer;
  }
  .adjust-row button:hover{ border-color:var(--warm); }
  .adjust-row label{ display:flex; align-items:center; gap:8px; width:100%; }
  input[type="range"]{ flex:1; accent-color:var(--warm); }

  footer{ text-align:center; margin-top:40px; font-size:11px; color:var(--text-muted); }
  footer button{ background:none; border:none; color:var(--text-muted); text-decoration:underline; cursor:pointer; font-size:11px; padding:0; }
</style>
</head>
<body>
<div class="page">

  <header class="title">
    <h1>愛着を抱くには</h1>
    <p>一言日記を積み重ねると、ヒビの振る舞いが少しずつ変わっていきます</p>
  </header>

  <section class="character-card">
    <div class="creature-wrap" id="creatureWrap">
      <svg viewBox="0 0 200 210" id="creatureSvg" style="width:100%;height:100%;overflow:visible;">
        <defs>
          <radialGradient id="glow" cx="50%" cy="48%" r="62%">
            <stop id="glowStop" offset="0%" stop-color="#F2B85C" stop-opacity="0.38"/>
            <stop offset="100%" stop-color="#F2B85C" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="bodyGrad" cx="38%" cy="30%" r="85%">
            <stop id="bodyStopA" offset="0%" stop-color="#454c78"/>
            <stop offset="100%" stop-color="#232838"/>
          </radialGradient>
        </defs>
        <circle cx="100" cy="105" r="98" fill="url(#glow)"/>
        <g id="particlesGroup"></g>
        <path id="blobPath" fill="url(#bodyGrad)" stroke="rgba(237,234,227,0.18)" stroke-width="1"/>
      </svg>
    </div>
    <p class="char-name">ヒビ</p>
    <div class="familiarity">
      <span class="fam-label" id="famLabel">なじみ度: まだ知り合ったばかり (0/30)</span>
      <div class="fam-bar"><div class="fam-fill" id="famFill"></div></div>
    </div>
    <p class="speech" id="speechText">はじめまして…今日あったこと、少しだけ聞かせてくれますか?</p>
  </section>

  <section class="panel">
    <h2>今日の記録</h2>
    <textarea id="diaryInput" placeholder="今日あったことを一言で(例: 友達とお昼にラーメンを食べた)"></textarea>
    <div class="mood-row" id="moodRow"></div>
    <div class="save-row">
      <span class="save-note" id="saveNote">今日はまだ記録されていません</span>
      <button class="save-btn" id="saveBtn">今日を記録する</button>
    </div>
  </section>

  <section class="panel">
    <h2>今週のようす <span id="weekStatus" class="week-status"></span></h2>
    <canvas id="weekChart" width="600" height="120"></canvas>
    <div class="highlight-pair">
      <div class="highlight-box" id="bestBox">
        <div class="h-label">今週いちばん良かった日</div>
        <div class="h-text" id="bestText">まだデータがありません</div>
      </div>
      <div class="highlight-box bad" id="worstBox">
        <div class="h-label">今週いちばん大変だった日</div>
        <div class="h-text" id="worstText">まだデータがありません</div>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>積み重ねてきたこと</h2>
    <div class="emblem-group">
      <div class="emblem-label">お祝いした週(<span id="celebrationCountLabel">0</span>回)</div>
      <div class="emblem-icons" id="celebrationEmblems"></div>
    </div>
    <div class="emblem-group">
      <div class="emblem-label">頑張った週(<span id="careCountLabel">0</span>回)</div>
      <div class="emblem-icons" id="careEmblems"></div>
    </div>
  </section>

  <section class="panel">
    <details>
      <summary id="historySummary">これまでの記録を見る(0件)</summary>
      <div class="history-list" id="historyList"></div>
    </details>
  </section>

  <section class="panel">
    <h2>日付となじみ度の調整</h2>
    <div class="adjust-row">
      <span>今日の日付(表示上): <strong id="simDateLabel">-</strong></span>
    </div>
    <div class="adjust-row">
      <button id="skip1Btn" type="button">+1日進める</button>
      <button id="skip7Btn" type="button">+7日進める</button>
      <button id="skipResetBtn" type="button">実際の日付に戻す</button>
    </div>
    <div class="adjust-row">
      <label for="famSlider">
        なじみ度(<span id="famSliderVal">0</span>/30)
        <input type="range" id="famSlider" min="0" max="30" step="1" value="0">
      </label>
    </div>
    <div class="adjust-row">
      <button id="demoGoodWeekBtn" type="button">「良い週」を1週間分まとめて用意</button>
      <button id="demoBadWeekBtn" type="button">「大変な週」を1週間分まとめて用意</button>
    </div>
  </section>

  <footer>
    <button id="resetBtn">すべての記録・なじみ度を消去する</button>
  </footer>

</div>

<script>
(function(){
  const STORAGE_KEY = 'hibi-diary-entries-v1';
  const FAMILIARITY_KEY = 'hibi-familiarity-v1';
  const OFFSET_KEY = 'hibi-demo-offset-v1';
  const CELEBRATION_COUNT_KEY = 'hibi-celebration-count-v1';
  const CARE_COUNT_KEY = 'hibi-care-count-v1';
  const MAX_FAMILIARITY = 30;
  const MAX_EMBLEM_ICONS = 12;
  const CENTER = {x:100, y:105};
  const BASE_RADIUS = 55;
  const BLOB_POINTS = 8;

  const MOODS = [
    {label:'良い',        score: 2, color:'#7FB77E'},
