  }

  function refreshAll(){
    const entries = loadEntries();
    const familiarity = loadFamiliarity();

    updateSpeech(entries, familiarity);
    updateWeekPanel(entries);
    updateHistory(entries);
    updateFamiliarityUI(familiarity);
    updateEmblems();

    els.simDateLabel.textContent = todayKey();

    const key = todayKey();
    if(entries[key]){
      els.saveNote.textContent = '今日はすでに記録済みです(保存すると上書きされます)';
    } else {
      els.saveNote.textContent = '今日はまだ記録されていません';
    }
  }

  els.saveBtn.addEventListener('click', () => {
    const text = els.diaryInput.value.trim();
    if(!text){
      els.saveNote.textContent = '一言でいいので、今日のことを書いてください';
      return;
    }
    if(selectedMoodIndex === null){
      els.saveNote.textContent = '今日の気分を選んでください';
      return;
    }
    const entries = loadEntries();
    const key = todayKey();
    const isNewDay = !entries[key];
    const mood = MOODS[selectedMoodIndex];
    entries[key] = { text, score: mood.score, label: mood.label };
    saveEntries(entries);
    lastSavedKey = key;

    if(isNewDay){
      saveFamiliarity(loadFamiliarity() + 1);
    }

    // 週が切り替わった直後の最初の記録だけ、前の週の内容に応じた特別な反応にする
    let isCareMoment = false;
    let isCelebrationMoment = false;
    if(isNewDay){
      const weeksAfter = getWeeks(entries);
      if(weeksAfter.length > 1 && weeksAfter[weeksAfter.length-1].length === 1){
        const prevWeek = weeksAfter[weeksAfter.length-2];
        const label = judgeWeek(prevWeek).label;
        isCareMoment = label === '大変な週';
        isCelebrationMoment = label === '良い週';
      }
    }

    els.diaryInput.value = '';
    selectedMoodIndex = null;
    [...els.moodRow.children].forEach(c=>{
      c.classList.remove('selected');
      c.style.background = '';
      c.style.color = '';
    });
    refreshAll();
    if(isCareMoment){
      playCareAnimation();
    } else if(isCelebrationMoment){
      playCelebrationAnimation();
    } else {
      playSaveAnimation();
    }
  });

  els.resetBtn.addEventListener('click', () => {
    if(confirm('すべての記録・なじみ度・日付設定を消去します。よろしいですか?')){
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(FAMILIARITY_KEY);
      localStorage.removeItem(OFFSET_KEY);
      localStorage.removeItem(CELEBRATION_COUNT_KEY);
      localStorage.removeItem(CARE_COUNT_KEY);
      lastSavedKey = null;
      refreshAll();
    }
  });

  els.skip1Btn.addEventListener('click', () => {
    saveOffset(loadOffset() + 1);
    refreshAll();
  });
  els.skip7Btn.addEventListener('click', () => {
    saveOffset(loadOffset() + 7);
    refreshAll();
  });
  els.skipResetBtn.addEventListener('click', () => {
    saveOffset(0);
    refreshAll();
  });
  els.famSlider.addEventListener('input', (e) => {
    const v = parseInt(e.target.value, 10);
    saveFamiliarity(v);
    const entries = loadEntries();
    updateSpeech(entries, v);
    updateFamiliarityUI(v);
  });

  // デバッグ用: 左矢印キー(←)を押すと表示上の日付が一ヶ月前に戻る
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      if (e.target.tagName === 'TEXTAREA' || e.target.tagName === 'INPUT') return;
      const d = getSimulatedDate();
      d.setMonth(d.getMonth() - 1);
      const diffDays = Math.round((d.getTime() - Date.now()) / 86400000);
      saveOffset(diffDays);
      refreshAll();
    }
  });

  // ---- 実演を楽にするための「1週間分まとめて用意」機能 ----
  // 過去7日分(今日は含まない)のダミー日記を一括生成する。今日の分は空けておくので、
  // 実演ではそのまま今日の記録をつけるだけで、先週分の反応(お祝い/ケア)がすぐ見られる。
  const GOOD_DEMO_TEXTS = ['友達と楽しく話せた', '美味しいごはんを食べた', '好きな音楽を聴けた', '課題が早く終わった', '天気が良くて気持ちよかった', '面白い本を読めた', '久しぶりに家族と話せた'];
  const BAD_DEMO_TEXTS = ['ちょっと疲れてしまった', '嫌なことがあった', '寝不足で辛かった', '課題に追われていた', '体調が優れなかった', '人間関係で悩んだ', '忙しくて余裕がなかった'];

  function generateDemoWeek(kind){
    const kindLabel = kind === 'good' ? '良い週' : '大変な週';
    if(!confirm(`現在の記録・なじみ度をすべて消して、「${kindLabel}」のダミー日記(過去7日分)を作成します。よろしいですか?`)) return;

    localStorage.removeItem(STORAGE_KEY);
    localStorage.removeItem(FAMILIARITY_KEY);
    localStorage.removeItem(OFFSET_KEY);
    localStorage.removeItem(CELEBRATION_COUNT_KEY);
    localStorage.removeItem(CARE_COUNT_KEY);
    lastSavedKey = null;

    const textPool = kind === 'good' ? GOOD_DEMO_TEXTS : BAD_DEMO_TEXTS;
    const scorePool = kind === 'good' ? [2,1,2,1,2,1,2] : [-2,-1,-2,-1,-2,-1,-2];
    const entries = {};
    for(let i=7;i>=1;i--){
      const d = new Date(Date.now() - i*86400000); // 今日より前の日付。今日の分はあえて作らない
      const key = dateKeyFor(d);
      const idx = 7 - i;
      const score = scorePool[idx % scorePool.length];
      const moodLabel = MOODS.find(m => m.score === score).label;
      entries[key] = { text: textPool[idx % textPool.length], score, label: moodLabel };
    }
    saveEntries(entries);
    saveFamiliarity(7); // 実際に7日分使ったのと同じだけなじみ度を進めておく
    saveOffset(0); // 今日は実際の日付のまま。ここから本番の記録をしてもらう
    refreshAll();
  }

  els.demoGoodWeekBtn.addEventListener('click', () => generateDemoWeek('good'));
  els.demoBadWeekBtn.addEventListener('click', () => generateDemoWeek('bad'));

  els.creatureWrap.setAttribute('role', 'button');
  els.creatureWrap.setAttribute('tabindex', '0');
  els.creatureWrap.setAttribute('aria-label', 'ヒビをつつく');
  els.creatureWrap.addEventListener('click', pokeCreature);
  els.creatureWrap.addEventListener('keydown', (e) => {
    if(e.key === 'Enter' || e.key === ' '){
      e.preventDefault();
      pokeCreature();
    }
  });

  renderMoodButtons();
  refreshAll();
  requestAnimationFrame(tick);
})();
</script>
</body>
</html>
