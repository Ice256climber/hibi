  ];

  // なじみ度の段階。値が大きいものから判定する。
  const TIERS = [
    {min:15, label:'すっかり馴染んだ', tone:'casual'},
    {min:5,  label:'少しずつ慣れてきた', tone:'semi'},
    {min:0,  label:'まだ知り合ったばかり', tone:'polite'}
  ];

  function pick(arr){ return arr[Math.floor(Math.random() * arr.length)]; }

  const SPEECH = {
    intro: {
      polite: [
        'はじめまして…今日あったこと、少しだけ聞かせてくれますか?',
        'こんにちは…今日は何かありましたか?',
