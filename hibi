  let selectedMoodIndex = null;
  let currentAvg = 0;          // 直近の気分平均。アニメーションループが常時参照する
  let currentFamiliarity = 0;
  let talkBoost = 0;           // 発言した直後に揺れが少し大きくなる演出用
  let time = 0;
  let lastTs = 0;
  let particles = [];          // なじみ度で増える光の粒

  // カーソル/タッチへの追従(ゆるやかにレンズのように寄ってくる)
  let followX = 0, followY = 0, targetFollowX = 0, targetFollowY = 0;
  // つつき・保存時の「ぷにっ」としたバネの跳ね返り
  let squishScale = 1, squishVelocity = 0;
  let pokeTimeoutId = null;
  let lastSavedKey = null; // 直近に「今日を記録する」で保存したキー(日付の並び順に頼らないため)

  const els = {
    diaryInput: document.getElementById('diaryInput'),
    moodRow: document.getElementById('moodRow'),
    saveBtn: document.getElementById('saveBtn'),
    saveNote: document.getElementById('saveNote'),
    speechText: document.getElementById('speechText'),
    creatureWrap: document.getElementById('creatureWrap'),
    blobPath: document.getElementById('blobPath'),
