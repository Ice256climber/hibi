    demoGoodWeekBtn: document.getElementById('demoGoodWeekBtn'),
    demoBadWeekBtn: document.getElementById('demoBadWeekBtn'),
    celebrationCountLabel: document.getElementById('celebrationCountLabel'),
    celebrationEmblems: document.getElementById('celebrationEmblems'),
    careCountLabel: document.getElementById('careCountLabel'),
    careEmblems: document.getElementById('careEmblems')
  };

  // ---- 日付(早送りに対応) ----
  function loadOffset(){
    const v = parseInt(localStorage.getItem(OFFSET_KEY), 10);
    return isNaN(v) ? 0 : v;
  }
  function saveOffset(v){ localStorage.setItem(OFFSET_KEY, String(v)); }
  function getSimulatedDate(){ return new Date(Date.now() + loadOffset() * 86400000); }
  function dateKeyFor(d){
    const pad = n => String(n).padStart(2,'0');
    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
  }
  function todayKey(){ return dateKeyFor(getSimulatedDate()); }

  // ---- 日記データ ----
  function loadEntries(){
    try{ return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }
    catch(e){ return {}; }
  }
  function saveEntries(entries){ localStorage.setItem(STORAGE_KEY, JSON.stringify(entries)); }
  function sortedDates(entries){ return Object.keys(entries).sort(); }

  // 直近7件を1週とみなして区切る(カレンダー週ではなく、記録7回ごとの区切り)
  function getWeeks(entries){
    const dates = sortedDates(entries);
    const weeks = [];
    for(let i=0;i<dates.length;i+=7){
      weeks.push(dates.slice(i,i+7).map(d => ({date:d, ...entries[d]})));
    }
    return weeks;
  }
  function judgeWeek(weekEntries){
    const total = weekEntries.reduce((s,e)=>s+e.score,0);
    if(total >= 5) return {label:'良い週', color:'var(--good)'};
    if(total <= -5) return {label:'大変な週', color:'var(--bad)'};
    return {label:'普通の週', color:'var(--neutral)'};
  }

  // ---- なじみ度(累積・週をまたいでもリセットされない) ----
  function loadFamiliarity(){
    const v = parseInt(localStorage.getItem(FAMILIARITY_KEY), 10);
    return isNaN(v) ? 0 : Math.max(0, Math.min(v, MAX_FAMILIARITY));
  }
  function saveFamiliarity(v){
    localStorage.setItem(FAMILIARITY_KEY, String(Math.max(0, Math.min(v, MAX_FAMILIARITY))));
  }
  function getTier(fam){ return TIERS.find(t => fam >= t.min); }

  // ---- お祝い/ケアの回数をエンブレムとして蓄積表示する ----
  function loadCount(key){
    const v = parseInt(localStorage.getItem(key), 10);
    return isNaN(v) ? 0 : v;
  }
  function saveCount(key, v){ localStorage.setItem(key, String(v)); }
  function incrementCount(key){
    const v = loadCount(key) + 1;
    saveCount(key, v);
    return v;
  }
  function renderEmblemIcons(container, count, icon){
    container.innerHTML = '';
    if(count === 0){
      const empty = document.createElement('span');
      empty.className = 'emblem-empty';
      empty.textContent = 'まだありません';
      container.appendChild(empty);
      return;
    }
    const shown = Math.min(count, MAX_EMBLEM_ICONS);
    for(let i=0;i<shown;i++){
      const s = document.createElement('span');
      s.textContent = icon;
      container.appendChild(s);
    }
    if(count > MAX_EMBLEM_ICONS){
      const more = document.createElement('span');
      more.className = 'emblem-overflow';
      more.textContent = `+${count - MAX_EMBLEM_ICONS}`;
      container.appendChild(more);
    }
  }
  function updateEmblems(){
    const cCount = loadCount(CELEBRATION_COUNT_KEY);
    const kCount = loadCount(CARE_COUNT_KEY);
    els.celebrationCountLabel.textContent = cCount;
    els.careCountLabel.textContent = kCount;
    renderEmblemIcons(els.celebrationEmblems, cCount, '✨');
    renderEmblemIcons(els.careEmblems, kCount, '♡');
  }

  function lerp(a,b,t){ return a + (b-a)*t; }
  function hexToRgb(hex){
    const v = parseInt(hex.replace('#',''),16);
    return [(v>>16)&255, (v>>8)&255, v&255];
  }
  function rgbToHex(r,g,b){
    return '#' + [r,g,b].map(x=>Math.round(x).toString(16).padStart(2,'0')).join('');
  }
  function lerpColor(hexA, hexB, t){
    const a = hexToRgb(hexA), b = hexToRgb(hexB);
    return rgbToHex(lerp(a[0],b[0],t), lerp(a[1],b[1],t), lerp(a[2],b[2],t));
  }
  function truncate(text, n){ return text.length > n ? text.slice(0,n) + '…' : text; }

  function renderMoodButtons(){
    els.moodRow.innerHTML = '';
    MOODS.forEach((m, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'mood-btn';
      btn.textContent = m.label;
      btn.addEventListener('click', () => {
        selectedMoodIndex = i;
        [...els.moodRow.children].forEach((c,ci)=>{
          c.classList.toggle('selected', ci===i);
          c.style.background = ci===i ? MOODS[ci].color : '';
          c.style.color = ci===i ? '#1B1F2B' : '';
        });
      });
      els.moodRow.appendChild(btn);
    });
  }

  // ---- 光の粒(なじみ度で増える) ----
  function particleCountFor(familiarity){
    return Math.min(10, Math.ceil((familiarity / MAX_FAMILIARITY) * 10));
  }
  function regenerateParticles(count){
    while(particles.length < count){
      particles.push({
        angle: Math.random()*Math.PI*2,
        radius: 76 + Math.random()*20,
        speed: (0.12 + Math.random()*0.22) * (Math.random()<0.5 ? 1 : -1),
        size: 1.3 + Math.random()*1.5,
        twinklePhase: Math.random()*Math.PI*2
      });
    }
    if(particles.length > count){ particles.length = count; }
  }
  function ensureParticleElements(){
    const g = els.particlesGroup;
    while(g.children.length < particles.length){
      const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
      c.setAttribute('fill', '#F2B85C');
      g.appendChild(c);
    }
    while(g.children.length > particles.length){
      g.removeChild(g.lastChild);
    }
  }
  function renderParticles(){
    ensureParticleElements();
    const g = els.particlesGroup;
    particles.forEach((p,i) => {
      const el = g.children[i];
      const x = CENTER.x + Math.cos(p.angle) * p.radius;
      const y = CENTER.y + Math.sin(p.angle) * p.radius * 0.94;
      el.setAttribute('cx', x.toFixed(1));
      el.setAttribute('cy', y.toFixed(1));
      el.setAttribute('r', p.size.toFixed(1));
      const twinkle = 0.35 + 0.6 * Math.abs(Math.sin(time*1.6 + p.twinklePhase));
      el.setAttribute('opacity', twinkle.toFixed(2));
    });
  }

  // ---- 有機的な形の揺らぎ(顔の代わりに、動きと色で気分を表現する) ----
  function moodToEnergy(avg){
    const t = (avg + 2) / 4; // 0..1 (0=悪い, 1=良い)
    return {
      speed: lerp(0.55, 1.9, t),     // 悪い日はゆっくり重く、良い日は軽やかに速く
      amplitude: lerp(2.5, 8, t)     // 悪い日はほとんど動かず、良い日は大きく弾む
    };
  }
  function computeBlobPoints(energy, boost){
    const points = [];
    for(let i=0;i<BLOB_POINTS;i++){
      const angle = (i / BLOB_POINTS) * Math.PI * 2;
      const wobble = Math.sin(time*energy.speed + i*1.7) * energy.amplitude
                   + Math.sin(time*energy.speed*1.9 + i*0.6) * energy.amplitude*0.4
                   + boost * Math.sin(time*9 + i) * 6;
      const r = BASE_RADIUS + wobble;
      points.push([
        CENTER.x + Math.cos(angle) * r,
        CENTER.y + Math.sin(angle) * r * 0.94
      ]);
    }
    return points;
  }
  function catmullRomPath(points){
    const n = points.length;
    let d = '';
    for(let i=0;i<n;i++){
      const p0 = points[(i-1+n)%n];
      const p1 = points[i];
      const p2 = points[(i+1)%n];
      const p3 = points[(i+2)%n];
      const cp1x = p1[0] + (p2[0]-p0[0])/6;
      const cp1y = p1[1] + (p2[1]-p0[1])/6;
      const cp2x = p2[0] - (p3[0]-p1[0])/6;
      const cp2y = p2[1] - (p3[1]-p1[1])/6;
      if(i===0) d += `M ${p1[0].toFixed(1)} ${p1[1].toFixed(1)} `;
      d += `C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)}, ${cp2x.toFixed(1)} ${cp2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)} `;
    }
    return d + 'Z';
  }

  function tick(ts){
    if(!lastTs) lastTs = ts;
    const dt = Math.min(0.05, (ts - lastTs) / 1000);
    lastTs = ts;
    time += dt;
    talkBoost *= Math.exp(-1.0 * dt); // フレームレートに依存しない減衰。以前より余韻を長く

    // カーソル/タッチにゆるやかに寄っていく(急には動かず、少し遅れてついてくる)
    const followEase = Math.min(1, dt * 6);
    followX += (targetFollowX - followX) * followEase;
    followY += (targetFollowY - followY) * followEase;

    // つつき・保存時の「ぷにっ」としたバネの跳ね返り(以前よりゆっくり大きく揺れて長く続く)
    const springForce = -90 * (squishScale - 1) - 8 * squishVelocity;
    squishVelocity += springForce * dt;
    squishScale += squishVelocity * dt;

    const bobY = Math.sin(time * 0.9) * 4;
    const rotate = followX * 0.5;
    els.creatureWrap.style.transform =
      `translate(${followX.toFixed(2)}px, ${(bobY + followY*0.3).toFixed(2)}px) rotate(${rotate.toFixed(2)}deg) scale(${squishScale.toFixed(3)})`;

    const energy = moodToEnergy(currentAvg);
    els.blobPath.setAttribute('d', catmullRomPath(computeBlobPoints(energy, talkBoost)));

    particles.forEach(p => { p.angle += p.speed * dt; });
    renderParticles();

    requestAnimationFrame(tick);
  }

  // ---- カーソル/タッチへの追従 ----
  function updatePointerTarget(clientX, clientY){
    const rect = els.creatureWrap.getBoundingClientRect();
    const cx = rect.left + rect.width/2;
    const cy = rect.top + rect.height/2;
    const dx = clientX - cx;
    const dy = clientY - cy;
    const dist = Math.sqrt(dx*dx + dy*dy) || 1;
    const influence = Math.max(0, 1 - dist/480); // 近いほど強く反応し、遠いと中心に戻る
    const maxOffset = 9;
    targetFollowX = (dx/dist) * maxOffset * influence;
    targetFollowY = (dy/dist) * maxOffset * influence;
  }
  document.addEventListener('mousemove', (e) => updatePointerTarget(e.clientX, e.clientY));
  document.addEventListener('touchmove', (e) => {
    if(e.touches && e.touches[0]){
      updatePointerTarget(e.touches[0].clientX, e.touches[0].clientY);
    }
  }, {passive:true});
  document.addEventListener('mouseleave', () => { targetFollowX = 0; targetFollowY = 0; });

  // ---- つつつくと少し反応する ----
  const POKE_REACTIONS = {
    polite: [
      'わっ、驚きました',
      'ふふ、くすぐったいです',
      'どうかしましたか?',
      'わたしに何か用ですか?',
      'ふふ、突然ですね'
    ],
    semi: [
      'わっ、びっくりした!',
      'ふふ、くすぐったいよ',
      'どうしたの?',
      'なになに?',
      'ふふ、急にどうしたの?'
    ],
    casual: [
      'きゃっ、びっくりした!',
      'えへへ、くすぐったいってば',
      'なになに、どうしたの?',
      'わっ!急に何?',
      'えへへ、つつかれちゃった'
    ]
  };
  function pokeCreature(){
    const familiarity = loadFamiliarity();
    const tier = getTier(familiarity);
    els.speechText.textContent = pick(POKE_REACTIONS[tier.tone]);
    talkBoost = 1.3;
    squishVelocity += 5.5;
    spawnHearts();
    if(pokeTimeoutId) clearTimeout(pokeTimeoutId);
    pokeTimeoutId = setTimeout(() => { refreshAll(); }, 2200);
  }

  // avgScore: 直近の気分平均(-2..2) / familiarity: 累積のなじみ度(0..30)
  function renderCreature(avgScore, familiarity){
    currentAvg = isNaN(avgScore) ? 0 : avgScore;
    currentFamiliarity = familiarity;
    regenerateParticles(particleCountFor(familiarity));

    const t = (currentAvg + 2) / 4;
    const moodColor = lerpColor('#C97064', '#7FB77E', t);
    els.glowStop.setAttribute('stop-color', moodColor);
    const glowOpacity = 0.28 + (familiarity / MAX_FAMILIARITY) * 0.35;
    els.glowStop.setAttribute('stop-opacity', Math.min(0.68, glowOpacity).toFixed(2));
    els.bodyStopA.setAttribute('stop-color', lerpColor('#454c78', moodColor, 0.22));
  }

  function updateSpeech(entries, familiarity){
    const tier = getTier(familiarity);
    const dates = sortedDates(entries);
    if(dates.length === 0){
      els.speechText.innerHTML = pick(SPEECH.intro[tier.tone]);
      renderCreature(0, familiarity);
      return;
    }
    const weeks = getWeeks(entries);
    const currentWeek = weeks[weeks.length-1];
    // 日付を早送り/リセットして使うと、実際の日付順では「未来」に記録した古いデータの方が
    // 後ろに並んでしまうことがある。そのため「日付が一番新しいもの」ではなく、
    // 「実際にさっき保存したもの」を優先して今日のセリフに反映する。
    const latestKey = (lastSavedKey && entries[lastSavedKey]) ? lastSavedKey : dates[dates.length-1];
    const latest = entries[latestKey];
    const recent = dates.slice(-3).map(d=>entries[d].score);
    const avg = recent.reduce((s,v)=>s+v,0) / recent.length;
    renderCreature(avg, familiarity);

    let msg = '';
    if(latest.score >= 2){
      msg = pick(SPEECH.good[tier.tone]);
    } else if(latest.score <= -2){
      msg = pick(SPEECH.bad[tier.tone]);
    } else if(latest.score === 1){
      msg = pick(SPEECH.okGood[tier.tone]);
    } else if(latest.score === -1){
      msg = pick(SPEECH.okBad[tier.tone]);
    } else {
      msg = pick(SPEECH.neutral[tier.tone]);
    }

    // 週の切り替わりのときは、今日の気分の反応に「先週の振り返り/ケア/お祝い」を補足として添える
    // (今日のセリフを上書きしない。悪い日には悪い日の反応をそのまま優先する)
    if(currentWeek.length === 1 && weeks.length > 1){
      const prevWeek = weeks[weeks.length-2];
      const judge = judgeWeek(prevWeek);
      const best = prevWeek.reduce((a,b)=> b.score>a.score?b:a);
      let weekNote;
      if(judge.label === '大変な週'){
        weekNote = CARE_MESSAGE[tier.tone];
      } else if(judge.label === '良い週'){
        weekNote = CELEBRATION_MESSAGE[tier.tone];
      } else {
        weekNote = newWeekMessage(judge.label, truncate(best.text,28), tier.tone);
      }
      msg = `${msg}<span class="quote">${weekNote}</span>`;
    }
    els.speechText.innerHTML = msg;
  }

  function updateFamiliarityUI(familiarity){
    const tier = getTier(familiarity);
    els.famLabel.textContent = `なじみ度: ${tier.label} (${familiarity}/${MAX_FAMILIARITY})`;
    els.famFill.style.width = `${(familiarity / MAX_FAMILIARITY) * 100}%`;
    els.famSlider.value = familiarity;
    els.famSliderVal.textContent = familiarity;
  }

  function updateWeekPanel(entries){
    const weeks = getWeeks(entries);
    if(weeks.length === 0){
      els.weekStatus.textContent = '';
      els.bestText.textContent = 'まだデータがありません';
      els.worstText.textContent = 'まだデータがありません';
      drawChart([]);
      return;
    }
    const currentWeek = weeks[weeks.length-1];
    const judge = judgeWeek(currentWeek);
    els.weekStatus.textContent = judge.label;
    els.weekStatus.style.background = judge.color;
    els.weekStatus.style.color = '#1B1F2B';

    const best = currentWeek.reduce((a,b)=> b.score>a.score?b:a);
    const worst = currentWeek.reduce((a,b)=> b.score<a.score?b:a);
    els.bestText.textContent = `${best.date}「${best.text}」`;
    els.worstText.textContent = `${worst.date}「${worst.text}」`;

    drawChart(currentWeek);
  }

  function drawChart(weekEntries){
    const canvas = els.weekChart;
    const ctx = canvas.getContext('2d');
    const w = canvas.width, h = canvas.height;
    ctx.clearRect(0,0,w,h);
    if(weekEntries.length === 0) return;

    const barW = w / 7;
    const midY = h/2;
    ctx.strokeStyle = 'rgba(237,234,227,0.15)';
    ctx.beginPath();
    ctx.moveTo(0, midY);
    ctx.lineTo(w, midY);
    ctx.stroke();

    weekEntries.forEach((e, i) => {
      const barH = (Math.abs(e.score) / 2) * (h/2 - 8);
      const x = i * barW + barW*0.25;
      const bw = barW*0.5;
      const color = e.score > 0 ? '#7FB77E' : e.score < 0 ? '#C97064' : '#9AA0B4';
      ctx.fillStyle = color;
      if(e.score >= 0){
        ctx.fillRect(x, midY - barH, bw, barH);
      } else {
        ctx.fillRect(x, midY, bw, barH);
      }
    });
  }

  function updateHistory(entries){
    const dates = sortedDates(entries).reverse();
    els.historySummary.textContent = `これまでの記録を見る(${dates.length}件)`;
    els.historyList.innerHTML = '';
    dates.forEach(d => {
      const e = entries[d];
      const mood = MOODS.find(m=>m.score===e.score) || MOODS[2];
      const row = document.createElement('div');
      row.className = 'history-item';
      row.innerHTML = `
        <div class="history-date">${d}</div>
        <div class="history-dot" style="background:${mood.color}"></div>
        <div class="history-text">${e.text}</div>
      `;
      els.historyList.appendChild(row);
    });
  }

  function spawnHearts(){
    // なじみ度が低いうちは控えめに、馴染むほどたくさん舞うようにする
    const count = 1 + Math.round((currentFamiliarity / MAX_FAMILIARITY) * 3); // 1〜4個
    for(let i=0;i<count;i++){
      const h = document.createElement('span');
      h.className = 'heart-particle';
      h.textContent = '♡';
      h.style.left = (10 + Math.random()*80) + '%';
      h.style.bottom = (8 + Math.random()*30) + '%';
      h.style.setProperty('--dx', (Math.random()*30 - 15) + 'px');
      h.style.animationDelay = (i * 0.15) + 's';
      els.creatureWrap.appendChild(h);
      setTimeout(() => h.remove(), 2400);
    }
  }

  // 頑張った週:急がず、灯りをそっと灯すように、少数がゆっくり立ちのぼる
  function spawnCareGlow(){
    for(let i=0;i<6;i++){
      const s = document.createElement('span');
      s.className = 'care-glow-orb';
      const size = 10 + Math.random()*10;
      s.style.width = size + 'px';
      s.style.height = size + 'px';
      s.style.left = (20 + Math.random()*60) + '%';
      s.style.bottom = (10 + Math.random()*20) + '%';
