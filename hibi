  // お祝いの週:中心から四方八方に一気にはじける、華やかで速いバースト
  function spawnCelebrationBurst(){
    const icons = ['✨', '⭐', '♡'];
    for(let i=0;i<12;i++){
      const s = document.createElement('span');
      s.className = 'celebrate-particle';
      s.textContent = icons[i % icons.length];
      s.style.color = (i % 2 === 0) ? 'var(--good)' : 'var(--warm)';
      s.style.fontSize = (14 + Math.random()*12) + 'px';
      s.style.left = '50%';
      s.style.bottom = '48%';

      const angle = -Math.PI/2 + (Math.random() - 0.5) * Math.PI * 1.3; // 上方向を中心に広く飛び散る
      const dist = 55 + Math.random()*75;
      s.style.setProperty('--dx', (Math.cos(angle) * dist).toFixed(1) + 'px');
      s.style.setProperty('--dy', (Math.sin(angle) * dist).toFixed(1) + 'px');
      s.style.setProperty('--rot', (Math.random()*360 - 180) + 'deg');
      s.style.animationDelay = (i * 0.03) + 's';

      els.creatureWrap.appendChild(s);
      setTimeout(() => s.remove(), 1600);
    }
  }

  function scrollCreatureIntoView(){
    els.creatureWrap.scrollIntoView({ behavior:'smooth', block:'center' });
